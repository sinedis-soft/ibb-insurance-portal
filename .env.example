# App
APP_ENV=local
APP_NAME=ibb-portal
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

# Backend
DATABASE_URL=postgresql+psycopg://ibb_portal:change_me_local_only@postgres:5432/ibb_portal
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change_me_local_only
COOKIE_SECRET=change_me_local_only
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Bitrix24
BITRIX_WEBHOOK_URL=replace_me
BITRIX_TIMEOUT_SECONDS=10
BITRIX_OUTBOUND_WEBHOOK_SECRET=replace_me

# Invites and email
PORTAL_PUBLIC_URL=http://localhost:3000
INVITE_TOKEN_TTL_HOURS=48
SMTP_HOST=replace_me
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM_EMAIL=replace_me@example.com
SMTP_USE_TLS=true

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=ibb_portal
POSTGRES_USER=ibb_portal
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
